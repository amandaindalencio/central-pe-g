# Copie este arquivo para .env.local (nunca commitar o .env.local de verdade)
# e, na Vercel, cadastre as mesmas chaves em Project Settings → Environment Variables.

# Senha de acesso ao dashboard (tela de login simples).
DASHBOARD_PASSWORD=

# Acesso ao Cockpit via MCP (mesmo protocolo/tools já usados pelo Claude Code
# durante a sessão que construiu este projeto — ver lib/cockpit.js). Copie os
# 3 valores à mão de mcpServers.cockpit no seu .claude.json:
#   COCKPIT_MCP_URL           -> campo "url"
#   COCKPIT_MCP_AUTHORIZATION -> campo "headers.Authorization" (inclui "Bearer " se tiver)
#   COCKPIT_MCP_GATEWAY_KEY   -> campo "headers['x-mcp-gateway']"
COCKPIT_MCP_URL=
COCKPIT_MCP_AUTHORIZATION=
COCKPIT_MCP_GATEWAY_KEY=

# Segredo usado pela Vercel para autenticar as chamadas de Cron Job
# (Project Settings → Cron Jobs mostra/gera isso automaticamente na Vercel;
# copie o mesmo valor aqui se quiser testar o cron localmente).
CRON_SECRET=

# Preenchidos automaticamente pela Vercel ao conectar um banco Redis/Upstash
# ao projeto (Storage → Create Database → Redis). Não precisa setar à mão em
# produção — só se for testar localmente contra um Redis real.
KV_REST_API_URL=
KV_REST_API_TOKEN=
